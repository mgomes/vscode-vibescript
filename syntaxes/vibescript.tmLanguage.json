{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vibescript",
  "scopeName": "source.vibescript",
  "fileTypes": [
    "vibe"
  ],
  "firstLineMatch": "^(?:#!.*\\bvibes\\b|# vibe: [0-9]+\\.[0-9]+)",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#definitions"
    },
    {
      "include": "#type-alias"
    },
    {
      "include": "#typed-local"
    },
    {
      "include": "#type-cast"
    },
    {
      "include": "#type-literals"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#control-keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#symbols"
    },
    {
      "include": "#hash-keys"
    },
    {
      "include": "#regexps"
    },
    {
      "include": "#brace-block-parameters"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "^=begin(?=\\s|$)",
          "end": "^=end(?=\\s|$).*",
          "name": "comment.block.vibescript"
        },
        {
          "include": "#line-comment"
        }
      ]
    },
    "definitions": {
      "patterns": [
        {
          "match": "\\b(export)\\b",
          "name": "keyword.declaration.export.vibescript"
        },
        {
          "match": "\\b(private|public|protected)\\b(?=\\s+(?:def|property|getter|setter)\\b)",
          "name": "keyword.declaration.visibility.vibescript"
        },
        {
          "comment": "Retroactive visibility: bare `private` or `public :name, :\"quoted\", :+`.",
          "match": "\\b(private|public|protected)\\b(?=\\s*$|\\s+:)",
          "name": "keyword.declaration.visibility.vibescript"
        },
        {
          "include": "#function-declaration"
        },
        {
          "include": "#bare-def"
        },
        {
          "include": "#class-declaration"
        },
        {
          "include": "#enum-declaration"
        },
        {
          "match": "\\b(module)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.module.vibescript"
            },
            "2": {
              "name": "entity.name.namespace.vibescript"
            }
          }
        }
      ]
    },
    "function-declaration": {
      "comment": "Sublime's function-declaration/function-name-after-self/function-signature-tail chain, flattened into one line-scoped rule. The name alternation is ordered longest-first because Oniguruma alternation is leftmost-first: setter names before plain ones, `[]=` before `[]`, multi-character operators before the single-character class.",
      "begin": "\\b(def)\\s+(?:(self)(\\.))?([a-z_][a-zA-Z0-9_]*=(?![=~>])|\\[\\]=|\\[\\]|<=>|<=|>=|==|!=|<<|//|\\*\\*|[a-z_][a-zA-Z0-9_]*[?!]?|[+\\-*/%<>&])",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.function.vibescript"
        },
        "2": {
          "name": "variable.language.self.vibescript"
        },
        "3": {
          "name": "punctuation.accessor.dot.vibescript"
        },
        "4": {
          "name": "entity.name.function.vibescript"
        }
      },
      "end": "$",
      "name": "meta.function.vibescript",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#parameters"
        },
        {
          "include": "#return-type"
        }
      ]
    },
    "bare-def": {
      "comment": "`def` with no name yet (mid-edit); keeps the keyword colored.",
      "match": "\\b(def)\\b",
      "name": "keyword.declaration.function.vibescript"
    },
    "parameters": {
      "begin": "\\(",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.group.begin.vibescript"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.group.end.vibescript"
        }
      },
      "name": "meta.group.parameters.vibescript",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "\\*\\*|\\*|&",
          "name": "keyword.operator.parameter.vibescript"
        },
        {
          "match": ",",
          "name": "punctuation.separator.parameter.vibescript"
        },
        {
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*",
          "name": "variable.parameter.instance.vibescript"
        },
        {
          "match": "[a-z_][a-zA-Z0-9_]*[?!]?",
          "name": "variable.parameter.vibescript"
        },
        {
          "include": "#parameter-type"
        },
        {
          "include": "#parameter-default"
        }
      ]
    },
    "parameter-type": {
      "begin": ":",
      "beginCaptures": {
        "0": {
          "name": "punctuation.separator.annotation.type.vibescript"
        }
      },
      "end": "(?=[,)=])",
      "name": "meta.annotation.type.vibescript",
      "patterns": [
        {
          "include": "#type-body"
        }
      ]
    },
    "parameter-default": {
      "comment": "Default values reuse the literal rules so `def f(mode = :read)` keeps symbol/number/string highlighting inside the signature.",
      "begin": "=",
      "beginCaptures": {
        "0": {
          "name": "keyword.operator.assignment.vibescript"
        }
      },
      "end": "(?=[,)])|$",
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#symbols"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "return-type": {
      "begin": "(->)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.separator.annotation.return-type.vibescript"
        }
      },
      "end": "$",
      "name": "meta.annotation.type.vibescript",
      "patterns": [
        {
          "include": "#type-body"
        }
      ]
    },
    "type-body": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#type-generics"
        },
        {
          "include": "#type-tuple"
        },
        {
          "include": "#block-type-arguments"
        },
        {
          "match": "->",
          "name": "punctuation.separator.annotation.return-type.vibescript"
        },
        {
          "match": "::|\\.",
          "name": "punctuation.accessor.vibescript"
        },
        {
          "match": "\\|",
          "name": "keyword.operator.union.vibescript"
        },
        {
          "match": "\\?",
          "name": "keyword.operator.optional.vibescript"
        },
        {
          "match": "\\bnil\\b",
          "name": "constant.language.null.vibescript"
        },
        {
          "include": "#type-shape"
        },
        {
          "match": "[A-Z][a-zA-Z0-9_]*",
          "name": "support.class.vibescript"
        },
        {
          "match": "[a-z_][a-zA-Z0-9_]*",
          "name": "support.type.vibescript"
        }
      ]
    },
    "type-shape": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.vibescript"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.vibescript"
        }
      },
      "name": "meta.annotation.type.vibescript",
      "patterns": [
        {
          "match": "\\.\\.\\.",
          "name": "keyword.operator.open-shape.vibescript"
        },
        {
          "match": "[a-z_][a-zA-Z0-9_]*\\??(?=\\s*:)",
          "name": "variable.other.member.vibescript"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#shape-field-type"
        },
        {
          "match": ",",
          "name": "punctuation.separator.sequence.vibescript"
        }
      ]
    },
    "shape-field-type": {
      "begin": ":",
      "beginCaptures": {
        "0": {
          "name": "punctuation.separator.annotation.type.vibescript"
        }
      },
      "end": "(?=[,}])",
      "name": "meta.annotation.type.vibescript",
      "patterns": [
        {
          "include": "#type-body"
        }
      ]
    },
    "class-declaration": {
      "patterns": [
        {
          "match": "\\b(class)\\s+([A-Z][a-zA-Z0-9_]*)",
          "name": "meta.class.vibescript",
          "captures": {
            "1": {
              "name": "keyword.declaration.class.vibescript"
            },
            "2": {
              "name": "entity.name.class.vibescript"
            }
          }
        },
        {
          "match": "\\b(class)\\b",
          "name": "keyword.declaration.class.vibescript"
        }
      ]
    },
    "enum-declaration": {
      "comment": "The name rides along in the begin match so no anchor is needed; members are bare words (constant or identifier), one or more, until `end`.",
      "begin": "\\b(enum)\\s+([A-Z][a-zA-Z0-9_]*|[a-z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.enum.vibescript"
        },
        "2": {
          "name": "entity.name.enum.vibescript"
        }
      },
      "end": "\\bend\\b",
      "endCaptures": {
        "0": {
          "name": "keyword.control.block.vibescript"
        }
      },
      "name": "meta.enum.vibescript",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "[A-Z][a-zA-Z0-9_]*|[a-z_][a-zA-Z0-9_]*[?!]?",
          "name": "constant.other.enum.vibescript"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\brequire\\b",
          "name": "keyword.control.import.vibescript"
        },
        {
          "include": "#member-declaration"
        },
        {
          "match": "\\b(alias_method)\\b",
          "name": "keyword.declaration.alias.vibescript"
        },
        {
          "include": "#alias-declaration"
        }
      ]
    },
    "member-declaration": {
      "begin": "\\b(property|getter|setter)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.member.vibescript"
        }
      },
      "end": "$",
      "name": "meta.declaration.member.vibescript",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "begin": ":",
          "beginCaptures": {
            "0": {
              "name": "punctuation.separator.annotation.type.vibescript"
            }
          },
          "end": "(?=[,=]|$)",
          "patterns": [
            {
              "include": "#type-body"
            }
          ]
        },
        {
          "match": "[a-z_][a-zA-Z0-9_]*[?!]?",
          "name": "variable.other.member.vibescript"
        },
        {
          "match": ",",
          "name": "punctuation.separator.sequence.vibescript"
        }
      ]
    },
    "alias-declaration": {
      "comment": "`alias new_name old_name` takes bare identifiers, symbols, or quoted symbols, space separated, on one line.",
      "begin": "\\b(alias)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.alias.vibescript"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#symbols"
        },
        {
          "match": "[a-z_][a-zA-Z0-9_]*[?!]?",
          "name": "entity.name.function.vibescript"
        }
      ]
    },
    "control-keywords": {
      "patterns": [
        {
          "match": "\\b(if|elsif|else|case|when|then)\\b",
          "name": "keyword.control.conditional.vibescript"
        },
        {
          "match": "\\b(while|for|in)\\b",
          "name": "keyword.control.loop.vibescript"
        },
        {
          "match": "\\b(begin|rescue|ensure)\\b",
          "name": "keyword.control.exception.vibescript"
        },
        {
          "match": "\\b(return|yield|raise|break|next|retry)\\b",
          "name": "keyword.control.flow.vibescript"
        },
        {
          "match": "\\b(end)\\b",
          "name": "keyword.control.block.vibescript"
        },
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.vibescript"
        },
        {
          "match": "\\b(nil)\\b",
          "name": "constant.language.null.vibescript"
        },
        {
          "match": "\\b(self)\\b",
          "name": "variable.language.self.vibescript"
        }
      ]
    },
    "brace-block-parameters": {
      "match": "(?<=\\{|\\{ )(\\|)([^|]*)(\\|)",
      "captures": {
        "1": {
          "name": "punctuation.separator.block-parameters.begin.vibescript"
        },
        "2": {
          "name": "meta.block.parameters.vibescript",
          "patterns": [
            {
              "include": "#block-parameter"
            }
          ]
        },
        "3": {
          "name": "punctuation.separator.block-parameters.end.vibescript"
        }
      }
    },
    "block-parameter": {
      "patterns": [
        {
          "begin": ":",
          "end": "(?=[,|])",
          "patterns": [
            {
              "include": "#type-body"
            }
          ]
        },
        {
          "match": "[a-z_][a-zA-Z0-9_]*[?!]?",
          "name": "variable.parameter.vibescript"
        },
        {
          "match": ",",
          "name": "punctuation.separator.parameter.vibescript"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "include": "#double-quoted-string"
        },
        {
          "include": "#single-quoted-string"
        }
      ]
    },
    "double-quoted-string": {
      "comment": "Any backslashed character is an escape (unknown ones produce the character itself); \\x.. and \\u.... take hex digits. `\\#` keeps a following `{` from opening an interpolation.",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.vibescript"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.vibescript"
        }
      },
      "name": "string.quoted.double.vibescript",
      "patterns": [
        {
          "match": "\\\\(?:x[0-9a-fA-F]{1,2}|u[0-9a-fA-F]{4}|[^\\n])",
          "name": "constant.character.escape.vibescript"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "single-quoted-string": {
      "comment": "Single-quoted strings only recognize \\' and \\\\; every other backslash (and any #{...}) is literal text.",
      "begin": "'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.vibescript"
        }
      },
      "end": "'",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.vibescript"
        }
      },
      "name": "string.quoted.single.vibescript",
      "patterns": [
        {
          "match": "\\\\['\\\\]",
          "name": "constant.character.escape.vibescript"
        }
      ]
    },
    "interpolation": {
      "comment": "The body re-enters the full expression grammar, so nested strings and nested interpolations come along for free. Braces balance so hash and block literals inside #{...} don't close the interpolation early.",
      "begin": "#\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.vibescript"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.vibescript"
        }
      },
      "name": "meta.interpolation.vibescript",
      "contentName": "meta.embedded.line.vibescript",
      "patterns": [
        {
          "include": "#interpolation-braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "interpolation-braces": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.vibescript"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.vibescript"
        }
      },
      "patterns": [
        {
          "include": "#interpolation-braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "numbers": {
      "comment": "An exponent marker makes the literal a float even without a decimal point (1e3 is 1000.0). Underscores sit between digits only.",
      "patterns": [
        {
          "match": "\\b0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*\\b",
          "name": "constant.numeric.integer.hexadecimal.vibescript"
        },
        {
          "match": "\\b0[bB][01](?:_?[01])*\\b",
          "name": "constant.numeric.integer.binary.vibescript"
        },
        {
          "match": "\\b0[oO][0-7](?:_?[0-7])*\\b",
          "name": "constant.numeric.integer.octal.vibescript"
        },
        {
          "match": "\\b0[dD]\\d(?:_?\\d)*\\b",
          "name": "constant.numeric.integer.decimal.vibescript"
        },
        {
          "match": "\\b\\d(?:_?\\d)*\\.\\d(?:_?\\d)*(?:[eE][+-]?\\d(?:_?\\d)*)?\\b",
          "name": "constant.numeric.float.vibescript"
        },
        {
          "match": "\\b\\d(?:_?\\d)*[eE][+-]?\\d(?:_?\\d)*\\b",
          "name": "constant.numeric.float.vibescript"
        },
        {
          "match": "\\b\\d(?:_?\\d)*\\b",
          "name": "constant.numeric.integer.vibescript"
        }
      ]
    },
    "symbols": {
      "comment": "Quoted symbols use the matching string quote's escapes, so an escaped quote stays inside the symbol (:'don\\'t'). Symbols may also name operators.",
      "patterns": [
        {
          "match": "(?<!:)(:)(\")(?:[^\"\\\\]|\\\\.)*(\")",
          "name": "constant.other.symbol.double-quoted.vibescript",
          "captures": {
            "1": {
              "name": "punctuation.definition.constant.vibescript"
            },
            "2": {
              "name": "punctuation.definition.constant.begin.vibescript"
            },
            "3": {
              "name": "punctuation.definition.constant.end.vibescript"
            }
          }
        },
        {
          "match": "(?<!:)(:)(')(?:[^'\\\\]|\\\\.)*(')",
          "name": "constant.other.symbol.single-quoted.vibescript",
          "captures": {
            "1": {
              "name": "punctuation.definition.constant.vibescript"
            },
            "2": {
              "name": "punctuation.definition.constant.begin.vibescript"
            },
            "3": {
              "name": "punctuation.definition.constant.end.vibescript"
            }
          }
        },
        {
          "match": "(?<!:)(:)(?:\\[\\]=|\\[\\]|===|<=>|\\*\\*|<<|<=|>=|==|!=|&&|\\|\\||[+\\-*/%<>&|!])",
          "name": "constant.other.symbol.operator.vibescript",
          "captures": {
            "1": {
              "name": "punctuation.definition.constant.vibescript"
            }
          }
        },
        {
          "match": "(?<!:)(:)[a-zA-Z_][a-zA-Z0-9_]*[?!]?",
          "name": "constant.other.symbol.vibescript",
          "captures": {
            "1": {
              "name": "punctuation.definition.constant.vibescript"
            }
          }
        }
      ]
    },
    "hash-keys": {
      "comment": "Hash keys and keyword arguments: { name: \"alex\" }, call(limit: 10)",
      "match": "([a-z_][a-zA-Z0-9_]*[?!]?)(:)(?!:)",
      "captures": {
        "1": {
          "name": "constant.other.symbol.vibescript"
        },
        "2": {
          "name": "punctuation.definition.constant.vibescript"
        }
      }
    },
    "regexps": {
      "comment": "A slash adjacent to another slash is floor division, never an empty regex.",
      "begin": "(?<![\\w)\\]}\"/])(/)(?![\\s=/])",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.vibescript"
        }
      },
      "end": "(/)([a-z]*)|$",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.vibescript"
        },
        "2": {
          "name": "keyword.other.flag.regexp.vibescript"
        }
      },
      "name": "string.regexp.vibescript",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.vibescript"
        },
        {
          "include": "#regexp-class"
        }
      ]
    },
    "regexp-class": {
      "begin": "\\[",
      "end": "\\]|$",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.vibescript"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "match": "@@[a-zA-Z_][a-zA-Z0-9_]*",
          "name": "variable.other.class.vibescript"
        },
        {
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*",
          "name": "variable.other.member.vibescript"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "(&\\.)([a-z_][a-zA-Z0-9_]*[?!]?)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.safe-navigation.vibescript"
            },
            "2": {
              "name": "variable.function.vibescript"
            }
          }
        },
        {
          "match": "(\\.)([a-z_][a-zA-Z0-9_]*[?!]?)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.dot.vibescript"
            },
            "2": {
              "name": "variable.function.vibescript"
            }
          }
        },
        {
