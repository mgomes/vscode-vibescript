{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "|", "close": "|", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["|", "|"]
  ],
  "autoCloseBefore": ";:.,=}])>| \n\t",
  "wordPattern": "(@{1,2})?[A-Za-z_][A-Za-z0-9_]*[?!]?",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:export\\s+)?(?:private\\s+)?def|class|enum|if|elsif|else|unless|while|until|for|case|when|begin|rescue|ensure)\\b|.*\\bdo\\b.*$",
    "decreaseIndentPattern": "^\\s*(?:[}\\]]\\s*$|(?:end|elsif|else|when|rescue|ensure)\\b)"
  },
  "folding": {
    "offSide": false,
    "markers": {
      "start": "^\\s*#\\s*region\\b",
      "end": "^\\s*#\\s*endregion\\b"
    }
  }
}
